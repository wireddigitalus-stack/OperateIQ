# ─────────────────────────────────────────────────────────────────────────────
# OperateIQ — environment template. Copy to .env.local and fill in.
# ★ = required for multi-tenancy to work.
# ─────────────────────────────────────────────────────────────────────────────

# ★ Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, never expose

# ★ Platform super-admins (server-only, comma-separated). The founder email is built in.
PLATFORM_ADMIN_EMAILS=

# Crew (PIN) session signing secret. Falls back to SUPABASE_SERVICE_ROLE_KEY if blank.
STAFF_SESSION_SECRET=

# ★ Public URL of the platform (used for host detection and links)
NEXT_PUBLIC_SITE_URL=https://getoperateiq.com
NEXT_PUBLIC_ALLOW_INDEXING=false

# AI
GEMINI_API_KEY=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=
CONTACT_NOTIFY_TO=
LEAD_NOTIFY_TO=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Market intel (optional Google News region expression)
MARKET_INTEL_REGION=

# Custom domains (Phase 5 — Vercel Domains API)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# DEPRECATED — no longer grants any access. Safe to delete.
NEXT_PUBLIC_ADMIN_EMAILS=
