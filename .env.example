# ─────────────────────────────────────────────────────────────────────────────
# PropOpsIQ — environment template. Copy to .env.local and fill in.
# ★ = required.
# ─────────────────────────────────────────────────────────────────────────────

# ★ Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, never expose

# ★ Platform super-admins (server-only, comma-separated). When set, this list
#   REPLACES the built-in founder fallback. Super-admins must have a verified email.
PLATFORM_ADMIN_EMAILS=

# Signing secrets (recommended: long random strings). Both fall back to
# SUPABASE_SERVICE_ROLE_KEY if blank.
STAFF_SESSION_SECRET=               # crew PIN sessions
EMAIL_VERIFY_SECRET=                # email verification links

# ★ Public URL of the platform (used for links in emails and host detection)
NEXT_PUBLIC_SITE_URL=https://www.propopsiq.com
NEXT_PUBLIC_ALLOW_INDEXING=true

# AI
GEMINI_API_KEY=

# Email (Resend) — signup verification, team invites, support tickets, leads
RESEND_API_KEY=
RESEND_FROM=                        # e.g. "PropOpsIQ <notifications@propopsiq.com>" (domain must be verified in Resend)
CONTACT_NOTIFY_TO=                  # platform team inbox: contact form + support tickets
LEAD_NOTIFY_TO=

# Cloudflare Turnstile — enforced on contact form and signup when BOTH are set
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe (SaaS subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=              # required — unsigned webhooks are rejected in every environment

# Optional
SUPABASE_URL=                       # server-side override of NEXT_PUBLIC_SUPABASE_URL
PLATFORM_ORG_ID=                    # defaults to 00000000-0000-0000-0000-000000000001
