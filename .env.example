# ─────────────────────────────────────────────────────────────────────────────
# PropOpsIQ — Environment Template. Copy to .env.local and fill in values.
# ★ = required to boot and authenticate workspaces.
# ─────────────────────────────────────────────────────────────────────────────

# ★ Supabase (Database, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only — never expose to browser
SUPABASE_URL=                       # optional server-side override of NEXT_PUBLIC_SUPABASE_URL

# ★ Platform Super-Admins & Tenancy
# Comma-separated verified emails granted /platform console & impersonation access.
PLATFORM_ADMIN_EMAILS=
PLATFORM_ORG_ID=                    # optional; defaults to 00000000-0000-0000-0000-000000000001

# ★ Signing Secrets (recommended: 32+ byte random hex/base64 strings)
# Fall back to SUPABASE_SERVICE_ROLE_KEY if left blank.
STAFF_SESSION_SECRET=               # signs crew 6-digit PIN httpOnly cookies
EMAIL_VERIFY_SECRET=                # signs email verification links

# ★ Canonical Site Origin & Search Indexing
NEXT_PUBLIC_SITE_URL=https://www.propopsiq.com
NEXT_PUBLIC_ALLOW_INDEXING=true

# Error Tracking & Operational Alerts (Sentry + Email Fallback)
# Accepts any Sentry DSN (zero-dependency HTTP Envelope transport built-in).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
ERROR_ALERT_EMAIL=                  # optional override; defaults to CONTACT_NOTIFY_TO

# AI (Google Gemini — intake OCR, lease bot, enhancement, QBR briefs)
GEMINI_API_KEY=

# Transactional Email (Resend — signup verification, invites, tickets, error alerts)
RESEND_API_KEY=
RESEND_FROM=                        # e.g. "PropOpsIQ <notifications@propopsiq.com>"
RESEND_FROM_EMAIL=                  # optional alias for RESEND_FROM
CONTACT_NOTIFY_TO=                  # founder / support inbox (receives support tickets & critical alerts)
LEAD_NOTIFY_TO=                     # optional sales lead notification inbox

# Cloudflare Turnstile Bot Protection (enforced on signup & contact when both are set)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Durable Rate Limiting (optional Upstash Redis REST; falls back to Supabase RPC + memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe Billing (use sk_test_... & test Price IDs during closed beta)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=              # required — unsigned webhooks are rejected in all environments
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
